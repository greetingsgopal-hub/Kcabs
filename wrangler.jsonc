{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "kainchi-dham-cabs",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/checkout",
      "/checkout/"
    ],
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
